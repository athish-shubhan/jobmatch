# Copy to .env and adjust. Only JWT_SECRET is required outside development.
DB_HOST=localhost
DB_PORT=3306
DB_USER=db_admin
# schema.sql creates db_admin with this password; change both together.
DB_PASSWORD=admin_pass
DB_NAME=jobmatch
PORT=5001
JWT_SECRET=change_me
# Optional: only needed for the AI Advisor page.
GEMINI_API_KEY=
